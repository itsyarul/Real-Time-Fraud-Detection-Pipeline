############################
# Project Configuration
############################
PROJECT_NAME=fraud-detection-platform
NETWORK_BACKEND=backend
NETWORK_FRONTEND=frontend

############################
# Base Image Versions
############################
PYTHON_VERSION=3.12
KAFKA_VERSION=4.3.1
SPARK_VERSION=4.0.1
DELTA_VERSION=4.0.1
POSTGRES_VERSION=16
AIRFLOW_VERSION=2.9.3
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.1

############################
# Apache Kafka
############################
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC=transactions
BRONZE_TRANSACTIONS_PATH=s3a://bronze/transactions
BRONZE_CHECKPOINT_LOCATION=s3a://spark-checkpoints/kafka-to-bronze

############################
# Apache Spark
############################
SPARK_IMAGE=fraud-streaming-spark:1.0
SPARK_KAFKA_CONNECTOR_VERSION=4.0.1
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_HISTORY_UI_PORT=18080
SPARK_WORKER_UI_PORT=8082
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3G
SPARK_STREAMING_CORES=1
SPARK_STREAMING_MEMORY=512m
SPARK_BATCH_CORES=1
SPARK_BATCH_MEMORY=1g

############################
# MinIO Object Storage
############################
HADOOP_AWS_VERSION=3.4.1
AWS_SDK_V2_VERSION=2.24.6
MINIO_S3_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=ChangeMeMinioPassword2026

############################
# Kafka Producer
############################
PRODUCER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PRODUCER_KAFKA_TOPIC=transactions
PRODUCER_MODE=continuous
PRODUCER_BATCH_SIZE=1000
PRODUCER_OFFSET=6000
PRODUCER_LOOP=true
PRODUCER_DELAY_MS=100
PRODUCER_SHUFFLE=true
PRODUCER_SEED=42

############################
# Silver Layer
############################
SILVER_TRANSACTIONS_PATH=s3a://silver/transactions
SILVER_CHECKPOINT_LOCATION=s3a://spark-checkpoints/bronze-to-silver
QUARANTINE_TRANSACTIONS_PATH=s3a://quarantine/transactions

############################
# Great Expectations
############################
GREAT_EXPECTATIONS_VERSION=1.19.1
GX_CONTEXT_ROOT=/opt/spark/work-dir/great_expectations
GX_SILVER_DATASOURCE_NAME=silver_spark_datasource
GX_SILVER_DATA_ASSET_NAME=silver_transactions
GX_SILVER_BATCH_DEFINITION_NAME=whole_silver_dataframe
GX_SILVER_EXPECTATION_SUITE_NAME=silver_transactions_suite
GX_SILVER_VALIDATION_DEFINITION_NAME=silver_transactions_validation

############################
# Machine Learning Training
############################
ML_MODEL_PATH=s3a://models/fraud-detection
ML_EXPERIMENT_PATH=s3a://ml-experiments/fraud-detection
ML_TRAINING_CORES=1
ML_TRAINING_MEMORY=1g
ML_RANDOM_SEED=42
ML_TEST_SIZE=0.2
ML_SOURCE_CSV_PATH=/opt/spark/work-dir/data/creditcard.csv
ML_TRAINING_DATA_PATH=s3a://ml-training/creditcard
ML_MODEL_NAME=fraud-logistic-regression
ML_MODEL_VERSION=production
ML_TRAIN_SIZE=0.80
ML_CLASS_WEIGHT_MODE=balanced
ML_PRIMARY_METRIC=average_precision
ML_MIN_PR_AUC=0.50
ML_DECISION_THRESHOLD=0.99
ML_MIN_RECALL=0.85

############################
# ML Inference
############################
ML_INFERENCE_MODEL_NAME=fraud-logistic-regression
ML_INFERENCE_MODEL_VERSION=production
ML_INFERENCE_THRESHOLD=0.99
ML_PREDICTIONS_PATH=s3a://predictions/fraud
ML_ALERTS_PATH=s3a://fraud-alerts/fraud
ML_INFERENCE_CHECKPOINT=s3a://spark-checkpoints/fraud-inference
ML_INFERENCE_CORES=1
ML_INFERENCE_MEMORY=512m
ML_MONITORING_PATH=s3a://monitoring/ml-inference

############################
# PostgreSQL (Airflow Metadata)
############################
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=ChangeMePostgresPassword
POSTGRES_PORT=5432

############################
# Apache Airflow
############################
AIRFLOW_IMAGE=fraud-detection-airflow:1.0
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=ChangeMeAdminPassword

############################
# Monitoring & Alerting
############################
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafanaPassword
PUSHGATEWAY_PORT=9091
KAFKA_EXPORTER_PORT=9308
ALERTMANAGER_PORT=9093
METRICS_PUSHER_IMAGE=fraud-detection-metrics-pusher:1.0

############################
# Alert Notifications (Slack)
############################
# Optional: Replace with your incoming Slack webhook URL for alerts
# Format: https://hooks.slack.com/services/T.../B.../XXXX
SLACK_WEBHOOK=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER
