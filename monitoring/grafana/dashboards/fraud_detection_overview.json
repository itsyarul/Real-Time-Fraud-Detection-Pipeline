{
  "uid": "fraud-overview",
  "title": "Fraud Detection — Overview",
  "description": "Real-time ML inference monitoring: fraud rates, prediction volumes, Kafka throughput, and pipeline health.",
  "tags": ["fraud-detection", "ml", "kafka", "spark"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [

    {
      "id": 1,
      "title": "Fraud Rate (Latest Batch)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red",    "value": 0.05 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "fraud_detection_fraud_rate",
          "legendFormat": "Fraud Rate",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Total Predictions Processed",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "fraud_detection_predictions_total",
          "legendFormat": "Predictions",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "🔴 Total Fraud Flags",
      "type": "stat",
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 100 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "fraud_detection_fraud_predictions_total",
          "legendFormat": "Fraud Predictions",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Total Batches Processed",
      "type": "stat",
      "gridPos": { "x": 14, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "fraud_detection_total_batches",
          "legendFormat": "Batches",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Model Decision Threshold",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "fraud_detection_model_decision_threshold",
          "legendFormat": "Threshold",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Fraud Rate Over Time",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 3, "w": 16, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "red",    "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "fraud_detection_fraud_rate",
          "legendFormat": "Fraud Rate",
          "refId": "A"
        },
        {
          "expr": "0.05",
          "legendFormat": "Alert Threshold (5%)",
          "refId": "B"
        }
      ]
    },

    {
      "id": 7,
      "title": "Fraud Probability Scores",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "fraud_detection_avg_fraud_probability",
          "legendFormat": "Avg Fraud Probability",
          "refId": "A"
        },
        {
          "expr": "fraud_detection_max_fraud_probability",
          "legendFormat": "Max Fraud Probability",
          "refId": "B"
        }
      ]
    },

    {
      "id": 8,
      "title": "⚡ Transaction Throughput (Kafka messages/sec)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(kafka_topic_partition_current_offset{topic=\"transactions\"}[1m])",
          "legendFormat": "Kafka messages/sec (transactions)",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red",    "value": 10000 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Fraud vs Normal Predictions (Latest Batch)",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "targets": [
        {
          "expr": "fraud_detection_fraud_predictions_total",
          "legendFormat": "Fraud",
          "refId": "A"
        },
        {
          "expr": "fraud_detection_predictions_total - fraud_detection_fraud_predictions_total",
          "legendFormat": "Normal",
          "refId": "B"
        }
      ]
    },

    {
      "id": 11,
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "horizontal"
      },
      "targets": [
        { "expr": "up{job=\"kafka-exporter\"}",  "legendFormat": "Kafka",      "refId": "A" },
        { "expr": "up{job=\"pushgateway\"}",      "legendFormat": "ML Inference","refId": "B" },
        { "expr": "up{job=\"minio\"}",            "legendFormat": "MinIO",      "refId": "C" },
        { "expr": "up{job=\"prometheus\"}",       "legendFormat": "Prometheus", "refId": "D" }
      ]
    }

  ]
}
